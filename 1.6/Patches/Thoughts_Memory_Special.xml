<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="SpecialSauce.Patching.PatchOperationSequenceIfSettingEnabled" MayRequire="Ludeon.RimWorld.Biotech">
		<modId>1trickpwnyta.anomalypatch</modId>
		<settingKey>InhumanPregnancyAttitude</settingKey>
		<operations>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThoughtDef[defName="PregnancyTerminated"]/nullifyingHediffs</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThoughtDef[defName="PregnancyTerminated"]</xpath>
					<value>
						<nullifyingHediffs />
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThoughtDef[defName="PregnancyTerminated"]/nullifyingHediffs</xpath>
				<value>
					<li>Inhumanized</li>
				</value>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/ThoughtDef[defName="PregnancyEnded"]/nullifyingHediffs</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>/Defs/ThoughtDef[defName="PregnancyEnded"]</xpath>
					<value>
						<nullifyingHediffs />
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThoughtDef[defName="PregnancyEnded"]/nullifyingHediffs</xpath>
				<value>
					<li>Inhumanized</li>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>